# confiddo-website (Vite) — env template. Copy to app/.env for local dev.
# Never commit app/.env or real secret values. VITE_* vars are inlined into the client
# bundle at build time, so they must be non-secret (public config only).

# Backend API base (public; the prod value is already the in-code fallback).
VITE_API_BASE_URL=https://conf007--confiddo-backend-fastapi-app.modal.run/v1

# Feature flag: show class rankings in the UI.
VITE_ENABLE_CLASS_RANKINGS=false
